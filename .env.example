APP_NAME="مركز حملة القرآن"
APP_ENV=production
APP_KEY=                          # فاضي الأول، هتولده بأمر بعد الـ deploy
APP_DEBUG=false
APP_URL=https://your-app-name.onrender.com    # ← لازم يتغير لدومين Render الحقيقي

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=                           # ← host الحقيقي من MySQL provider اللي هتختاره
DB_PORT=3306
DB_DATABASE=                       # ← اسم قاعدة البيانات الحقيقي
DB_USERNAME=                       # ← مش root — provider خارجي هيديك username مخصص
DB_PASSWORD=                       # ← password حقيقي، مش فاضي

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

TRACKING_START_TIME="14:00"
TRACKING_END_TIME="17:00"

VITE_APP_NAME="${APP_NAME}"